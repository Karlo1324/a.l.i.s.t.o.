        }
      ],
      "expo-location",
      "expo-sqlite"
    ],
    "extra": {
      "eas": {
        "projectId": "81dbb864-ef8c-464e-af72-5011a1b1ecee"
      }
    },
    "icon": "./assets/logo-light.png"
  }
